# Copy to .env. JWT_SECRET is required; everything else is optional (defaults as in the Node server).
# The HTTP API with database and mails was removed on 09.10.2026 – only the websocket server runs.

WS_PORT=7073
# server-side WebSocket PING frames (seconds); keeps sockets of hidden tabs alive
WS_PING_INTERVAL_SECS=25
SYSTEMID=WSS#001

JWT_SECRET=


KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=websockerserver_v1
KAFKA_PRICES_BROKERS=localhost:9092
KAFKA_PRICES_CLIENT_ID=websockerserver_v1
CLUSTER_NODE=node01


# RUST_LOG=debug,rdkafka=info

# --- IONOS (09.10.2026) ------------------------------------------------------------------
# JWT_SECRET ist Pflicht (keine Vorgabe mehr im Quelltext): derselbe Schlüssel wie im Authserver.
# Kafka-TLS wie bei Configserver/was: plaintext (Vorgabe) | ssl mit Client-Zertifikat
# KAFKA_SECURITY_PROTOCOL=ssl
# KAFKA_SSL_CA_LOCATION=/certs/kafka-ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/certs/kafka-client.pem
# KAFKA_SSL_KEY_LOCATION=/certs/kafka-client.key
# KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=none
# KAFKA_COMPRESSION_TYPE=gzip
# KAFKA_SESSION_TIMEOUT_MS=10000
# Consumer-Gruppe (Vorgabe KAFKA_CLIENT_ID) – je Instanz eindeutig; Start einer neuen Gruppe
# KAFKA_GROUP=
# KAFKA_AUTO_OFFSET_RESET=earliest
# zweiter Cluster: gesetzt und leer = aus (keine Nutzerzahlen ins Topic prices)
# KAFKA_PRICES_BROKERS=
# LOG_FILES=0 schreibt nur auf die Konsole (Container)
# LOG_FILES=1
